{
  "manifestVersion": 3,
  "env": {
    "PATH": "$(pnpm -c exec \"node --print process.env.PATH\")"
  },
  "tasks": {
    "build": {
      "name": "build",
      "description": "Full release build",
      "steps": [
        {
          "spawn": "default"
        },
        {
          "spawn": "pre-compile"
        },
        {
          "spawn": "compile"
        },
        {
          "spawn": "post-compile"
        },
        {
          "spawn": "test"
        },
        {
          "spawn": "package"
        }
      ]
    },
    "bump": {
      "name": "bump",
      "description": "Bumps version based on latest git tag and generates a changelog entry",
      "env": {
        "OUTFILE": "package.json",
        "CHANGELOG": "dist/changelog.md",
        "BUMPFILE": "dist/version.txt",
        "RELEASETAG": "dist/releasetag.txt",
        "RELEASE_TAG_PREFIX": "",
        "BUMP_PACKAGE": "commit-and-tag-version@^12"
      },
      "steps": [
        {
          "builtin": "release/resolve-latest-tag",
          "outputEnv": "LATEST_TAG"
        },
        {
          "spawn": "bump:releasable-commits",
          "outputEnv": "RELEASABLE_COMMITS",
          "condition": "git rev-parse --verify --quiet \"refs/tags/$LATEST_TAG\""
        },
        {
          "builtin": "release/suggest-version-bump",
          "outputEnv": "SUGGESTED_BUMP"
        },
        {
          "builtin": "release/apply-version-bump"
        }
      ],
      "condition": "git log --oneline -1 | grep -v \"chore(release):\" > /dev/null"
    },
    "bump:releasable-commits": {
      "name": "bump:releasable-commits",
      "description": "Print the releasable commits since the latest release",
      "steps": [
        {
          "exec": "git log --no-merges --oneline $LATEST_TAG..HEAD -E --grep '^(feat|fix){1}(\\([^()[:space:]]+\\))?(!)?:[[:blank:]]+.+'"
        }
      ]
    },
    "clobber": {
      "name": "clobber",
      "description": "hard resets to HEAD of origin and cleans the local repo",
      "env": {
        "BRANCH": "$(git branch --show-current)"
      },
      "steps": [
        {
          "execArgs": [
            "git",
            "checkout",
            "-b",
            "scratch"
          ],
          "name": "save current HEAD in \"scratch\" branch"
        },
        {
          "exec": "git checkout \"$BRANCH\""
        },
        {
          "execArgs": [
            "git",
            "fetch",
            "origin"
          ],
          "name": "fetch latest changes from origin"
        },
        {
          "exec": "git reset --hard \"origin/$BRANCH\"",
          "name": "hard reset to origin commit"
        },
        {
          "execArgs": [
            "git",
            "clean",
            "-fdx"
          ],
          "name": "clean all untracked files"
        },
        {
          "say": "ready to rock! (unpushed commits are under the \"scratch\" branch)"
        }
      ],
      "condition": "git diff --exit-code > /dev/null"
    },
    "compile": {
      "name": "compile",
      "description": "Only compile"
    },
    "default": {
      "name": "default",
      "description": "Synthesize project files",
      "steps": [
        {
          "exec": "pnpm exec ts-node --project tsconfig.projen.json .projenrc.ts"
        }
      ]
    },
    "eject": {
      "name": "eject",
      "description": "Remove projen from the project",
      "env": {
        "PROJEN_EJECTING": "true"
      },
      "steps": [
        {
          "spawn": "default"
        }
      ]
    },
    "format": {
      "name": "format",
      "steps": [
        {
          "exec": "prettier --write ."
        }
      ]
    },
    "format:check": {
      "name": "format:check",
      "steps": [
        {
          "exec": "prettier --check ."
        }
      ]
    },
    "install": {
      "name": "install",
      "description": "Install project dependencies and update lockfile (non-frozen)",
      "steps": [
        {
          "exec": "pnpm i --no-frozen-lockfile"
        }
      ]
    },
    "install:ci": {
      "name": "install:ci",
      "description": "Install project dependencies using frozen lockfile",
      "steps": [
        {
          "exec": "pnpm i --frozen-lockfile"
        }
      ]
    },
    "package": {
      "name": "package",
      "description": "Creates the distribution package",
      "steps": [
        {
          "execArgs": [
            "mkdir",
            "-p",
            "dist/js"
          ]
        },
        {
          "execArgs": [
            "pnpm",
            "pack",
            "--pack-destination",
            "dist/js"
          ]
        }
      ]
    },
    "post-compile": {
      "name": "post-compile",
      "description": "Runs after successful compilation"
    },
    "post-upgrade": {
      "name": "post-upgrade",
      "description": "Runs after upgrading dependencies"
    },
    "pre-compile": {
      "name": "pre-compile",
      "description": "Prepare the project for compilation"
    },
    "release": {
      "name": "release",
      "description": "Prepare a release from \"main\" branch",
      "env": {
        "RELEASE": "true",
        "MIN_MAJOR": "1"
      },
      "steps": [
        {
          "execArgs": [
            "rm",
            "-fr",
            "dist"
          ]
        },
        {
          "spawn": "bump"
        },
        {
          "spawn": "build"
        },
        {
          "spawn": "unbump"
        },
        {
          "exec": "git diff --ignore-space-at-eol --exit-code"
        }
      ]
    },
    "test": {
      "name": "test",
      "description": "Run tests",
      "steps": [
        {
          "spawn": "test:tsconfig"
        },
        {
          "spawn": "format:check"
        }
      ]
    },
    "test:tsconfig": {
      "name": "test:tsconfig",
      "steps": [
        {
          "exec": "pnpx --package=typescript@5.9.3 -- tsc --project src/tsconfig.node-22.json --noEmit"
        },
        {
          "exec": "pnpx --package=typescript@5.9.3 -- tsc --project src/tsconfig.node-24.json --noEmit"
        },
        {
          "exec": "pnpx --package=typescript@5.9.3 -- tsc --project src/tsconfig.node-ts.json --noEmit"
        },
        {
          "exec": "pnpx --package=typescript@5.9.3 -- tsc --project src/tsconfig.pedantic.json --noEmit"
        },
        {
          "exec": "pnpx --package=typescript@6.0.2 -- tsc --project src/tsconfig.node-22.json --noEmit"
        },
        {
          "exec": "pnpx --package=typescript@6.0.2 -- tsc --project src/tsconfig.node-24.json --noEmit"
        },
        {
          "exec": "pnpx --package=typescript@6.0.2 -- tsc --project src/tsconfig.node-ts.json --noEmit"
        },
        {
          "exec": "pnpx --package=typescript@6.0.2 -- tsc --project src/tsconfig.pedantic.json --noEmit"
        }
      ]
    },
    "unbump": {
      "name": "unbump",
      "description": "Restores version to 0.0.0",
      "env": {
        "OUTFILE": "package.json",
        "CHANGELOG": "dist/changelog.md",
        "BUMPFILE": "dist/version.txt",
        "RELEASETAG": "dist/releasetag.txt",
        "RELEASE_TAG_PREFIX": "",
        "BUMP_PACKAGE": "commit-and-tag-version@^12"
      },
      "steps": [
        {
          "builtin": "release/reset-version"
        }
      ]
    },
    "upgrade": {
      "name": "upgrade",
      "description": "upgrade dependencies",
      "env": {
        "CI": "0"
      },
      "steps": [
        {
          "execArgs": [
            "pnpm",
            "dlx",
            "npm-check-updates@20",
            "--upgrade",
            "--target=minor",
            "--peer",
            "--no-deprecated",
            "--dep=dev,prod,peer,optional",
            "--filter=@types/node,prettier,projen,shx,ts-node,typescript"
          ]
        },
        {
          "exec": "pnpm i --no-frozen-lockfile"
        },
        {
          "execArgs": [
            "pnpm",
            "update",
            "@types/node",
            "commit-and-tag-version",
            "constructs",
            "prettier",
            "projen",
            "shx",
            "ts-node",
            "typescript"
          ]
        },
        {
          "exec": "pnpx projen"
        },
        {
          "spawn": "post-upgrade"
        }
      ]
    }
  },
  "//": "~~ Generated by projen. To modify, edit .projenrc.ts and run \"pnpx projen\"."
}
